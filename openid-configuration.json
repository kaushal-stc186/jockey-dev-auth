{
  "issuer": "https://jockey-dev-auth.onrender.com",
  "authorization_endpoint": "https://jockey-dev-auth.onrender.com/authorize",
  "token_endpoint": "https://jockey-dev-auth.onrender.com/token",
  "userinfo_endpoint": "https://jockey-dev-auth.onrender.com/userinfo",
  "jwks_uri": "https://jockey-dev-auth.onrender.com/.well-known/jwks.json",
  "end_session_endpoint": "https://jockey-dev-auth.onrender.com/logout",
  "scopes_supported": ["openid", "email", "profile", "phone"],
  "response_types_supported": ["code"],
  "grant_types_supported": ["authorization_code", "refresh_token"],
  "token_endpoint_auth_methods_supported": ["client_secret_basic", "client_secret_post"],
  "subject_types_supported": ["public"],
  "id_token_signing_alg_values_supported": ["RS256"],
  "code_challenge_methods_supported": ["S256"],
  "claims_supported": [
    "sub",
    "iss",
    "aud",
    "exp",
    "iat",
    "nonce",
    "email",
    "email_verified",
    "phone_number",
    "phone_number_verified",
    "given_name",
    "family_name",
    "name"
  ]
}
